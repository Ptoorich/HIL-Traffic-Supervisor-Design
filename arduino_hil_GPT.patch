new file mode 100644
index 0000000..9ef15a5
--- /dev/null
+++ b/arduino/asta_display_GPT/asta_display_GPT.ino
@@ -0,0 +1,213 @@
+// UNO R3 logical-phase display. Protocol and bench instructions: ARDUINO_HIL_GUIDE_GPT.md.
+// EEPROM bytes 0..7 store a signature and boot counter for stale-session rejection.
+#include <Arduino.h>
+#include <EEPROM.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const uint16_t ALL_RED = (1U << 2) | (1U << 5) | (1U << 8) | (1U << 11);
+static const uint32_t WATCHDOG_MS = 3000, FRAME_MS = 200, FLASH_MS = 500;
+static const size_t CAPACITY = 160;
+static char input[CAPACITY], previous[CAPACITY];
+static size_t used = 0;
+static bool dropping = false, faulted = false, flashing = true, redOn = true;
+static bool acceptedHello = false, watching = false, closed = false;
+static uint32_t bootId = 0, sessionId = 0, sequence = 0, lastAccepted = 0;
+static uint32_t flashAt = 0, frameAt = 0, lastSim = 0;
+static bool haveSim = false;
+static uint16_t lastMask = ALL_RED;
+static char lastKind = 'H';
+
+static uint16_t crc16(const char *s) {
+  uint16_t crc = 0xFFFF;
+  while (*s) {
+    crc ^= (uint16_t)(uint8_t)*s++ << 8;
+    for (uint8_t i = 0; i < 8; ++i)
+      crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
+  }
+  return crc;
+}
+
+static void sendPayload(const char *payload) {
+  char tail[7];
+  snprintf(tail, sizeof(tail), "*%04X\n", crc16(payload));
+  Serial.print(payload);
+  Serial.print(tail);
+}
+
+static void errorReply(const char *code, char kind = 'N') {
+  char reply[90];
+  snprintf(reply, sizeof(reply), "1,%c,%lu,%lu,%s", kind,
+           (unsigned long)sessionId, (unsigned long)sequence, code);
+  sendPayload(reply);
+}
+
+// Break before make across ALL twelve outputs, including old red lamps.
+static void applyMask(uint16_t mask) {
+  for (uint8_t i = 0; i < 12; ++i) digitalWrite(i + 2, LOW);
+  for (uint8_t i = 0; i < 12; ++i)
+    if (mask & (1U << i)) digitalWrite(i + 2, HIGH);
+}
+
+static uint16_t readMask() {
+  uint16_t mask = 0;
+  for (uint8_t i = 0; i < 12; ++i)
+    if (digitalRead(i + 2) == HIGH) mask |= 1U << i;
+  return mask;
+}
+
+static void enterFault(const char *code) {
+  if (faulted) return;
+  faulted = true; watching = false; flashing = true; redOn = true;
+  flashAt = millis();
+  applyMask(ALL_RED);
+  errorReply(code, 'E');
+  // Latched until board reset. HELLO cannot silently rearm a fault.
+}
+
+static void serviceTimers() {
+  uint32_t now = millis();
+  if (watching && (uint32_t)(now - lastAccepted) >= WATCHDOG_MS) enterFault("WATCHDOG");
+  if (flashing && (uint32_t)(now - flashAt) >= FLASH_MS) {
+    redOn = !redOn; flashAt = now;
+    applyMask(redOn ? ALL_RED : 0);
+  }
+  if (used && (uint32_t)(now - frameAt) >= FRAME_MS) {
+    used = 0; dropping = true;  // Discard through LF, never accept a timed-out fragment.
+  }
+}
+
+static bool number(const char *s, uint32_t &out) {
+  if (!*s) return false;
+  uint32_t value = 0;
+  for (; *s; ++s) {
+    if (*s < '0' || *s > '9') return false;
+    uint8_t digit = *s - '0';
+    if (value > (UINT32_MAX - digit) / 10UL) return false;
+    value = value * 10 + digit;
+  }
+  out = value; return true;
+}
+
+static void acknowledge() {
+  char reply[90];
+  uint16_t actual = readMask();
+  if (actual != lastMask) { enterFault("GPIO"); return; }
+  snprintf(reply, sizeof(reply), "1,A,%lu,%lu,%u,%c",
+           (unsigned long)sessionId, (unsigned long)sequence, actual, lastKind);
+  sendPayload(reply);
+}
+
+static uint16_t junctionMask(uint8_t phase) {
+  // G/Y/R pin order for A then B. Both all-red stages remain distinct on the wire.
+  static const uint8_t masks[6] = {33, 34, 36, 12, 20, 36};
+  return masks[phase];
+}
+
+static void handleLine() {
+  char *star = strchr(input, '*');
+  if (!star || strlen(star + 1) != 4) return;
+  uint16_t expected = 0;
+  for (char *p = star + 1; *p; ++p) {
+    if (!((*p >= '0' && *p <= '9') || (*p >= 'A' && *p <= 'F'))) return;
+    expected = (expected << 4) | (*p <= '9' ? *p - '0' : *p - 'A' + 10);
+  }
+  *star = 0;
+  if (crc16(input) != expected) return;
+  if (faulted) return;  // Discard traffic after a fault; do not block flashing with replies.
+  char work[CAPACITY]; strcpy(work, input);
+  char *fields[10]; uint8_t count = 1;
+  fields[0] = work;
+  for (char *p = work; *p; ++p) {
+    if (*p == ',') {
+      if (count >= 10) return;
+      *p = 0; fields[count++] = p + 1;
+    }
+  }
+  if (count < 4 || strcmp(fields[0], "1") || strlen(fields[1]) != 1) return;
+  uint32_t sid, seq;
+  if (!number(fields[2], sid) || !sid || !number(fields[3], seq)) return;
+  char kind = fields[1][0];
+  if (kind == 'H') {
+    if (count != 4 || seq != bootId) return;
+    if (acceptedHello) {
+      if (!closed && sid == sessionId && sequence == 0 && !strcmp(previous, input)) acknowledge();
+      return;
+    }
+    sessionId = sid; sequence = 0; lastKind = 'H'; lastMask = ALL_RED;
+    acceptedHello = true; watching = true; flashing = false;
+    lastAccepted = millis(); applyMask(ALL_RED);
+    strcpy(previous, input); acknowledge(); return;
+  }
+  if (!acceptedHello || sid != sessionId) return;
+  if (seq == sequence && !strcmp(previous, input)) {
+    acknowledge(); return;  // No output reapplication and no watchdog refresh.
+  }
+  if ((closed && kind != 'F') || seq <= sequence) return;
+  uint16_t mask = ALL_RED;
+  uint32_t sim = lastSim;
+  if (kind == 'S') {
+    uint32_t p1, p2, m1, m2;
+    if (count != 9 || !number(fields[4], sim) || !number(fields[5], p1) ||
+        !number(fields[6], p2) || !number(fields[7], m1) || !number(fields[8], m2) ||
+        p1 > 5 || p2 > 5 || m1 > 2 || m2 > 2 || (haveSim && sim < lastSim)) {
+      errorReply("STATE"); return;
+    }
+    mask = junctionMask(p1) | (junctionMask(p2) << 6);
+  } else if ((kind != 'P' && kind != 'X' && kind != 'F') || count != 4) {
+    errorReply("COMMAND"); return;
+  }
+  sequence = seq;
+  if (kind == 'F') { enterFault("HOST"); return; }
+  applyMask(mask);
+  if (readMask() != mask) { enterFault("GPIO"); return; }
+  lastMask = mask; lastKind = kind; flashing = false;
+  lastAccepted = millis(); watching = kind == 'S';
+  if (kind == 'S') { lastSim = sim; haveSim = true; }
+  if (kind == 'X') closed = true;
+  strcpy(previous, input); acknowledge();
+}
+
+void setup() {
+  for (uint8_t pin = 2; pin <= 13; ++pin) {
+    digitalWrite(pin, LOW); pinMode(pin, OUTPUT);
+  }
+  applyMask(ALL_RED); flashAt = millis();
+  Serial.begin(115200);
+  const uint32_t signature = 0x41535441UL;
+  uint32_t storedSignature, storedBoot;
+  EEPROM.get(0, storedSignature); EEPROM.get(4, storedBoot);
+  if (storedSignature != signature) storedBoot = 0;
+  if (storedBoot == UINT32_MAX) { enterFault("BOOT_COUNTER"); return; }
+  bootId = storedBoot + 1;
+  EEPROM.put(4, bootId); EEPROM.put(0, signature);
+  EEPROM.get(4, storedBoot); EEPROM.get(0, storedSignature);
+  if (storedBoot != bootId || storedSignature != signature) {
+    enterFault("EEPROM"); return;
+  }
+  char reply[40];
+  snprintf(reply, sizeof(reply), "1,R,%lu", (unsigned long)bootId);
+  sendPayload(reply);
+}
+
+void loop() {
+  serviceTimers();
+  // Bound each pass so input floods cannot starve watchdog/flash service.
+  for (uint8_t n = 0; n < 32 && Serial.available(); ++n) {
+    serviceTimers();
+    int byte = Serial.read();
+    if (byte == '\n') {
+      if (!dropping && used) { input[used] = 0; handleLine(); }
+      used = 0; dropping = false;
+    } else if (!dropping) {
+      if (byte < 32 || byte > 126 || used >= CAPACITY - 1) {
+        used = 0; dropping = true;
+      } else {
+        if (!used) frameAt = millis();
+        input[used++] = (char)byte;
+      }
+    }
+  }
+}
diff --git a/supervisor/hil_serial_GPT.py b/supervisor/hil_serial_GPT.py
new file mode 100644
index 0000000..a6b0131
--- /dev/null
+++ b/supervisor/hil_serial_GPT.py
@@ -0,0 +1,219 @@
+"""Bounded, acknowledged USB transport for the UNO logical-phase display."""
+from __future__ import annotations
+
+import binascii
+import json
+from pathlib import Path
+import secrets
+import time
+
+ALL_RED = 2340
+PHASE_MASKS = (33, 34, 36, 12, 20, 36)
+MAX_FRAME = 160
+UINT32_MAX = 2**32 - 1
+
+
+class DisplayError(RuntimeError):
+    pass
+
+
+def encode_frame(*fields):
+    payload = ','.join(str(x) for x in fields).encode('ascii')
+    frame = payload + f'*{binascii.crc_hqx(payload, 0xFFFF):04X}\n'.encode('ascii')
+    if len(frame) > MAX_FRAME:
+        raise DisplayError('Serial frame exceeds 160 bytes')
+    return frame
+
+
+def decode_frame(frame):
+    try:
+        if len(frame) > MAX_FRAME or not frame.endswith(b'\n'):
+            raise ValueError('missing LF or oversize frame')
+        payload, crc = frame[:-1].split(b'*')
+        if len(crc) != 4 or any(c not in b'0123456789ABCDEF' for c in crc):
+            raise ValueError('invalid CRC spelling')
+        if binascii.crc_hqx(payload, 0xFFFF) != int(crc, 16):
+            raise ValueError('CRC mismatch')
+        fields = payload.decode('ascii').split(',')
+        if fields[0] != '1':
+            raise ValueError('unsupported protocol version')
+        return fields
+    except (ValueError, UnicodeError) as exc:
+        raise DisplayError(f'Invalid serial frame: {exc}') from exc
+
+
+def uint32(value):
+    if type(value) is not int or not 0 <= value <= UINT32_MAX:
+        raise DisplayError(f'Expected uint32, got {value!r}')
+    return value
+
+
+class SerialDisplay:
+    """One outstanding transaction; failure terminates this session, never reconnects."""
+    def __init__(self, port, *, log_path, serial_instance=None, ack_timeout=0.5,
+                 ready_timeout=8.0, clock=time.monotonic, sleep=time.sleep):
+        if not 0 < ack_timeout <= 0.5 or ready_timeout <= 0:
+            raise ValueError('Invalid serial deadline')
+        self.port, self.log_path = port, Path(log_path)
+        self.serial = serial_instance
+        self.clock, self.sleep = clock, sleep
+        self.ack_timeout, self.ready_timeout = ack_timeout, ready_timeout
+        self.session = secrets.randbelow(UINT32_MAX) + 1
+        self.sequence = 0
+        self.log = None
+        self.buffer = bytearray()
+        self.failed = False
+        self.started = False
+        self.closed = False
+
+    def record(self, event, **fields):
+        if self.log is not None:
+            self.log.write(json.dumps({'event': event, 'host_monotonic': self.clock(),
+                'session': self.session, **fields}, allow_nan=False) + '\n')
+            self.log.flush()
+
+    def _line(self, deadline):
+        while self.clock() < deadline:
+            byte = self.serial.read(1)
+            if not byte:
+                continue
+            self.buffer.extend(byte)
+            if len(self.buffer) > MAX_FRAME:
+                raise DisplayError('Oversize board response')
+            if byte == b'\n':
+                line = bytes(self.buffer)
+                self.buffer.clear()
+                return decode_frame(line)
+        return None
+
+    def __enter__(self):
+        try:
+            self.log = self.log_path.open('x', encoding='utf-8')
+            if self.serial is None:
+                import serial
+                self.serial = serial.Serial(self.port, 115200, timeout=0.01, write_timeout=0.1)
+                # Uno USB DTR reset. Drain prior traffic BEFORE releasing reset.
+                self.serial.dtr = False
+                self.sleep(0.05)
+                self.serial.reset_input_buffer()
+                self.serial.dtr = True
+            ready = self._line(self.clock() + self.ready_timeout)
+            if ready is None or len(ready) != 3 or ready[:2] != ['1', 'R']:
+                raise DisplayError('No protocol-v1 READY; reset Uno and start a new run')
+            boot = uint32(int(ready[2]))
+            self.record('ready', boot=boot, port=self.port)
+            self._exchange(encode_frame(1, 'H', self.session, boot), 'H', ALL_RED)
+            self.started = True
+            self.pause()  # SUMO startup may take seconds; active freshness begins with STATE.
+            return self
+        except BaseException:
+            self._close()
+            raise
+
+    def _exchange(self, frame, kind, expected_mask):
+        sent = self.clock()
+        deadline = sent + self.ack_timeout
+        for attempt in range(2):
+            if self.clock() >= deadline:
+                break
+            if self.serial.write(frame) != len(frame):
+                raise DisplayError('Incomplete serial write')
+            until = sent + self.ack_timeout / 2 if attempt == 0 else deadline
+            while self.clock() < until:
+                fields = self._line(until)
+                if fields is None:
+                    break
+                if fields[1:2] == ['R']:
+                    raise DisplayError('Arduino reset during session')
+                if len(fields) >= 3 and fields[2] != str(self.session):
+                    continue
+                if fields[1:2] in (['E'], ['N']):
+                    raise DisplayError('Arduino rejected state: ' + ','.join(fields))
+                if len(fields) != 6 or fields[:2] != ['1', 'A']:
+                    raise DisplayError('Malformed ACK')
+                if fields[3] != str(self.sequence):
+                    continue
+                if fields[4:] != [str(expected_mask), kind]:
+                    raise DisplayError('ACK output mask/type differs from command')
+                if self.clock() >= deadline:
+                    raise DisplayError('ACK arrived after deadline')
+                self.record('ack', sequence=self.sequence, kind=kind, mask=expected_mask,
+                            sent_at=sent, rtt_ms=(self.clock() - sent) * 1000, attempts=attempt + 1)
+                return
+        raise DisplayError('Arduino ACK deadline exceeded (500 ms maximum)')
+
+    def _command(self, kind, values=(), mask=ALL_RED):
+        if not self.started or self.failed or self.closed:
+            raise DisplayError('Display session is not active')
+        try:
+            self.sequence = uint32(self.sequence + 1)
+            self._exchange(encode_frame(1, kind, self.session, self.sequence, *values), kind, mask)
+        except BaseException as exc:
+            self.fault(exc)
+            raise
+
+    def state(self, sim_ms, phases, modes):
+        uint32(sim_ms)
+        if (len(phases) != 2 or len(modes) != 2 or
+            any(type(p) is not int or p not in range(6) for p in phases) or
+            any(type(m) is not int or m not in range(3) for m in modes)):
+            raise DisplayError('Expected two phase codes 0..5 and mode codes 0..2')
+        mask = PHASE_MASKS[phases[0]] | PHASE_MASKS[phases[1]] << 6
+        self._command('S', (sim_ms, *phases, *modes), mask)
+
+    def pause(self):
+        self._command('P')
+
+    def stop(self):
+        self._command('X')
+        self.closed = True
+
+    def verify_watchdog(self):
+        """Bench test: deliberately send nothing and require the firmware timeout event."""
+        deadline = self.clock() + 4.0
+        expected = ['1', 'E', str(self.session), str(self.sequence), 'WATCHDOG']
+        while self.clock() < deadline:
+            response = self._line(deadline)
+            if response == expected:
+                self.failed = True  # Preserve flashing red on exit; do not issue STOP.
+                self.record('watchdog_verified', evidence='firmware report; visually check flashing LEDs')
+                return
+            if response and response[1:2] == ['A'] and response[2:3] == [str(self.session)]:
+                continue  # A delayed duplicate ACK is not the watchdog outcome.
+            raise DisplayError(f'Expected watchdog report, received {response!r}')
+        raise DisplayError('Missing watchdog report')
+
+    def fault(self, reason):
+        if self.failed:
+            return
+        self.failed = True
+        try:
+            if self.serial is not None and self.started and self.sequence < UINT32_MAX:
+                self.serial.write(encode_frame(1, 'F', self.session, self.sequence + 1))
+        except Exception:
+            pass  # The board's own freshness watchdog remains the fallback.
+        try:
+            self.record('fault', reason=str(reason))
+        except Exception:
+            pass
+
+    def _close(self):
+        try:
+            if self.serial is not None:
+                self.serial.close()
+        finally:
+            if self.log is not None:
+                self.log.close()
+
+    def __exit__(self, typ, value, tb):
+        try:
+            if typ is not None:
+                self.fault(value)
+            elif not self.failed and not self.closed:
+                try:
+                    self.stop()
+                except BaseException as exc:
+                    self.fault(exc)
+                    raise
+        finally:
+            self._close()
